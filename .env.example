# Telegram API credentials from https://my.telegram.org
API_ID=123456
API_HASH=replace_with_api_hash

# Bot token used only to validate Telegram Mini App initData
BOT_TOKEN=123456789:replace_with_bot_token

# Your Telegram numeric user ID; only this user can open the Mini App API
OWNER_ID=123456789

# Forum supergroup ID where matched videos are sent
TARGET_CHAT=-1001234567890

# FastAPI listens on 127.0.0.1 only
PORT=8080

# Optional: custom path to the existing Flowseal proxy.env file
# Default: ~/.config/tg-ws-proxy-test/proxy.env
# TG_WS_PROXY_ENV_FILE=/home/adelf/.config/tg-ws-proxy-test/proxy.env
TG_WS_PROXY_HOST=127.0.0.1
TG_WS_PROXY_PORT=1443

# Telegram Mini App initData validity window
INIT_DATA_MAX_AGE_SECONDS=3600
